{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 96,
  "tabWidth": 2,
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.md"],
      "options": { "printWidth": 100, "proseWrap": "preserve" }
    },
    {
      "files": ["*.sql"],
      "options": { "printWidth": 120 }
    }
  ]
}
