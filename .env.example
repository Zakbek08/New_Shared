##############################################################################
# WalletWise — environment template
#
# Copy to `.env` and fill in values for YOUR OWN development project.
#   cp .env.example .env
#
# `.env` is git-ignored. Never commit real values.
# Only `EXPO_PUBLIC_*` variables are inlined into the mobile bundle — treat
# every one of them as public, because they ship to the device.
##############################################################################

# ---------------------------------------------------------------------------
# Supabase (client-side, safe to ship)
# ---------------------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklmno.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
# The *anon* (publishable) key. RLS is what protects your data — see SECURITY.md.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# App configuration (client-side)
# ---------------------------------------------------------------------------
# development | staging | production
EXPO_PUBLIC_ENVIRONMENT=development
# Enables the fictional demo catalog and the on-screen "DEMO DATA" banner.
EXPO_PUBLIC_ENABLE_DEMO_DATA=true
# Analytics / error monitoring. Left blank => events go to a no-op sink.
EXPO_PUBLIC_ANALYTICS_WRITE_KEY=
EXPO_PUBLIC_ERROR_MONITORING_DSN=

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — never prefix these with EXPO_PUBLIC_
# These belong in Supabase Edge Function secrets or your CI secret store,
# NOT in the mobile bundle.
# ---------------------------------------------------------------------------
# Bypasses RLS. Used only by migrations, seeding and admin tooling.
SUPABASE_SERVICE_ROLE_KEY=
# Local Postgres connection string for `supabase db` / Prisma introspection.
SUPABASE_DB_URL=
# Used only to interpret free-text purchase descriptions and phrase
# explanations. It MUST NOT be used to compute or invent reward rates.
ANTHROPIC_API_KEY=
